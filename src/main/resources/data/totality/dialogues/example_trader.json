          "next": "shipment",
          "hidden": true,
          "conditions": [
            { "type": "flag", "flag": "knows_about_shipment", "min": 1 }
          ]
        }
      ]
    },
    "shop_opened": {
      "text": "",
      "type": "end"
    },
    "farewell": {
      "text": "Safe travels, friend. Come back anytime.",
      "type": "end"
    },
    "discount_success": {
      "text": "Ha! You drive a hard bargain. Alright, I'll give you ten percent off.",
      "type": "end"
    },
    "discount_fail": {
